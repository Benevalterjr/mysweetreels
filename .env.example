# ==============================================================
# SweetReels - Variáveis de Ambiente
# ==============================================================
# Copie este arquivo para .env e preencha com suas credenciais:

# 1. Google Gemini Flash (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui

# 2. Cloudinary CDN (Plano gratuito: https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# 3. InfoPrice API (Busca de Preços de Ingredientes por CEP)
INFOPRICE_USERNAME=seu_email_infoprice
INFOPRICE_PASSWORD_HASH=seu_hash_senha_infoprice
INFOPRICE_CLIENT_ID=253155
INFOPRICE_BASE_URL=https://api.v2.infoprice.co

# 4. Porta do Servidor Local (Opcional, padrão: 3000)
PORT=3000
